{
  "expo": {
    "name": "PSGIM One",
    "slug": "aswin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.collegemonitor.attendancemonitor"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.collegemonitor.attendancemonitor",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "themeColor": "#0F172A",
      "backgroundColor": "#0F172A",
      "name": "Attendance Monitor",
      "shortName": "Attendance",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0284C7"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "9493178d-c80b-4bd4-8096-62d73d2f527f"
      }
    }
  }
}
